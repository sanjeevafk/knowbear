{
  "manifest_version": 3,
  "name": "KnowBear — Explain Selection",
  "version": "0.1.0",
  "description": "Highlight a passage or screenshot anything, and get an explanation at 4 depths without leaving the page.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "clipboardRead", "clipboardWrite", "scripting", "activeTab", "offscreen"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://knowbear.sanjeevkumar.me/*", "https://knowbear.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KnowBear",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Alt+K" },
      "description": "Explain current selection (rebindable in chrome://extensions/shortcuts)"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["lib/protocol.js", "lib/context.js", "lib/meme.js", "lib/styles.js", "lib/api.js", "content.js"],
      "match_origin_as_fallback": true,
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["file:///*"],
      "js": ["lib/protocol.js", "lib/context.js", "lib/meme.js", "lib/styles.js", "lib/api.js", "content.js"],
      "match_origin_as_fallback": true,
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2", "icons/*.png"], "matches": ["<all_urls>"] }
  ]
}
