{
    "name": "knowbear-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5173",
        "dev:api": "python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000 --app-dir api",
        "local:deps:frontend": "npm install",
        "local:deps:api": "python -m pip install -r api/requirements.txt",
        "local:deps": "npm run local:deps:frontend && npm run local:deps:api",
        "local:start": "npm run local:deps && concurrently -k -n FRONTEND,BACKEND -c cyan,green \"npm run dev\" \"npm run dev:api\"",
        "docker:start": "concurrently -k -n FRONTEND,BACKEND -c cyan,green \"npm run dev\" \"npm run dev:api\"",
        "build": "node node_modules/vite/bin/vite.js build",
        "vercel-build": "npm run build",
        "type-check": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "preview": "vite preview",
        "test": "vitest"
    },
    "dependencies": {
        "framer-motion": "^12.28.1",
        "lucide-react": "^0.562.0",
        "mermaid": "^10.6.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.12.0",
        "remark-gfm": "^4.0.1",
        "zod": "^3.25.76",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@types/node": "^25.0.9",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.13.0",
        "jsdom": "^24.0.0",
        "postcss": "^8.4.35",
        "prettier": "^3.2.4",
        "tailwindcss": "^3.4.1",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.18.1",
        "vite": "^6.4.5",
        "vitest": "^3.0.0",
        "concurrently": "^9.2.1"
    }
}
